[Unit]
Description=Remnawave Quota Manager Service
After=network.target

[Service]
Type=simple
User=remna-quota
Group=remna-quota
WorkingDirectory=/opt/remna-quota-manager
ExecStart=/opt/remna-quota-manager/.venv/bin/python /opt/remna-quota-manager/main.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/remna-quota-manager/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target